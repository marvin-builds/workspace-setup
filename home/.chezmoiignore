{{- /* Scripts that have a twin for the other OS family. */ -}}
{{ if eq .chezmoi.os "windows" -}}
.chezmoiscripts/git-identities.sh
{{ else -}}
.chezmoiscripts/git-identities.ps1
{{ end -}}

{{- /* The bash base and the old rc migration are Linux only, like their
       os: [linux] checks; Git Bash and macOS come in their own phases. */ -}}
{{ if ne .chezmoi.os "linux" -}}
.bashrc
.config/shell
.config/shell/**
.chezmoiscripts/migrate-20261113-old-rc-blocks.sh
{{ end -}}

{{- /* The package installer uses apt (slice 5); winget, scoop and brew
       come with their OS phases. */ -}}
{{ if ne .chezmoi.os "linux" -}}
.chezmoiscripts/install-packages.sh
{{ end -}}

{{- /* The tool installer runs mise, which comes from apt (slice 6); the
       lockfile pins Linux platforms only. */ -}}
{{ if ne .chezmoi.os "linux" -}}
.chezmoiscripts/install-tools.sh
{{ end -}}

{{- /* The font linker (slice 7): a Linux desktop only. Other forms get
       the fonts from mise too, but nothing there shows them. */ -}}
{{ if or (ne .chezmoi.os "linux") (ne .form "desktop") -}}
.chezmoiscripts/link-fonts.sh
{{ end -}}

{{- /* Externals (slice 7): yazi's plugins are Linux only, like yazi's
       install. chezmoi downloads an external whenever it reads the source
       state, even with --exclude externals; only an ignored target is
       skipped. So applying into another directory than the home (tests,
       previews) leaves them out, like the scripts' destination guard. */ -}}
{{ if or (ne .chezmoi.os "linux") (ne .chezmoi.destDir .chezmoi.homeDir) -}}
.config/yazi/plugins/piper.yazi
.config/yazi/plugins/piper.yazi/**
{{ end -}}
